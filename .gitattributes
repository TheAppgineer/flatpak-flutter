# Normalise text files to LF in the repo.
* text=auto eol=lf

# Patch files must be stored and checked out byte-for-byte unchanged.
# Some patches contain CRLF context lines (e.g. packages that ship CRLF files
# on pub.dev, or patches generated by `flutpak generate`); git must not
# re-normalise them on checkout.
*.patch -text
